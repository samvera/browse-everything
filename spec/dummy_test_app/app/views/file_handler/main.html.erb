<div class="jumbotron">
  <h1>Welcome!</h1>

  <p>Please click the button below to start pickin' files!</p>

  <%= form_tag('/file', id: 'main_form', method: 'post') do %>
    <%= button_tag("Browse", type: 'button', class: 'btn btn-large btn-success', id: "browse-btn",
      'data-toggle' => 'browse-everything', 'data-route' => browse_everything_engine.root_path,
      'data-target' => '#main_form') %>
    <%= button_tag("Submit", type: 'submit', class: 'btn btn-large btn-primary', id: "submit-btn") %>
  <% end %>

  <p id="status">0 items selected</p>

  <script>
    // jQuery is no longer needed to initialize browse-everything. The button uses data-toggle
    // attributes to auto-initialize the browse-everything button using vanilla JavaScript.

    // In the simplest approach to adding browse-everything, `data-toggle` attribute causes
    // auto-initialization via the `auto_toggle` function in behavior.js,
    // which runs on DOMContentLoaded event. The button click handler is set up automatically.
    // Callbacks can be added by listening to custom events, as seen in this demo.

    document.addEventListener('DOMContentLoaded', function() {
      var btn = document.getElementById('browse-btn');

      // Initialize browse-everything with callbacks
      if (window.initBrowseEverything && btn) {
        window.initBrowseEverything(btn)
          .done(function(data) {
            document.getElementById('status').textContent = data.length + ' items selected';
          })
          .cancel(function() {
            window.alert('Canceled!');
          });
      }
    });
  </script>
</div>
